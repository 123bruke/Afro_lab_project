# ── ContextFlow · Smart SDK System ─────────────────────────────────────
# Copy this file to `.env.local` and fill in real values:
#     cp .env.example .env.local
# Never commit real keys — `.gitignore` already excludes local .env files.

# ── Google Gemini ──────────────────────────────────────────────────────
# GEMINI_API_KEY: Required for real Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ── App hosting URL ────────────────────────────────────────────────────
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# Locally this is the Vite dev server, e.g. http://localhost:3000
APP_URL="http://localhost:3000"

# ── Dev server ─────────────────────────────────────────────────────────
# Vite already runs on port 3000 / host 0.0.0.0 via `npm run dev`.
# Override only if you change the dev script in package.json.
PORT=3000
HOST=0.0.0.0

# ── Context Engine endpoint ────────────────────────────────────────────
# VITE_ENGINE_ENDPOINT: base URL of the ContextFlow engine the workspace
# connects to. This pre-fills the "Context Engine Endpoint" field under
# Settings → API. The mock UI runs fine without it.
# Exposed to the browser, so never put secrets here.
VITE_ENGINE_ENDPOINT="http://localhost:8080"

# ── Telemetry (optional) ───────────────────────────────────────────────
# VITE_TELEMETRY_ENDPOINT: optional endpoint that receives analytics /
# telemetry events when you wire real reporting. Leave empty to disable.
VITE_TELEMETRY_ENDPOINT=""